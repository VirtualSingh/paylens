{
  "mcpServers": {
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "neon": {
      "type": "http",
      "url": "https://mcp.neon.tech/mcp"
    },
    "nx-mcp": {
      "type": "stdio",
      "command": "node",
      "args": [
        "node_modules/nx-mcp/main.js",
        "--disableTelemetry",
        "--minimal=false"
      ],
      "env": {}
    }
  }
}
