{
  "name": "@paylens/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "name": "api",
    "tags": [
      "type:api"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "cwd": "apps/api",
          "command": "tsc --build tsconfig.app.json"
        }
      },
      "serve": {
        "executor": "nx:run-commands",
        "continuous": true,
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "apps/api",
          "parallel": true,
          "commands": [
            "tsc --build tsconfig.app.json --watch --preserveWatchOutput",
            "node --watch --enable-source-maps dist/main.js"
          ]
        }
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/swagger": "^12.1.2",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@nestjs/testing": "^12.5.0",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2"
  }
}
