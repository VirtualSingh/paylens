{
  "name": "@paylens/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "nx run-many -t serve -p api web",
    "prepare": "husky",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --dir apps/api exec drizzle-kit generate",
    "db:migrate": "pnpm --dir apps/api exec drizzle-kit migrate",
    "db:seed": "nx run api:build && node --env-file-if-exists=.env apps/api/dist/db/seed/cli.js"
  },
  "private": true,
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@nx/devkit": "24.0.6",
    "@nx/eslint": "24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@nx/js": "24.0.6",
    "@nx/nest": "24.0.6",
    "@nx/node": "24.0.6",
    "@nx/playwright": "24.0.6",
    "@nx/react": "24.0.6",
    "@nx/vite": "24.0.6",
    "@nx/vitest": "24.0.6",
    "@nx/web": "24.0.6",
    "@playwright/test": "^1.37.0",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "~5.0.1",
    "@vitest/ui": "~5.0.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-security": "^4.2.1",
    "husky": "^9.1.7",
    "jiti": "2.4.2",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^17.6.0",
    "nx": "24.0.6",
    "nx-mcp": "0.25.3",
    "prettier": "^3.8.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "~5.0.1"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  }
