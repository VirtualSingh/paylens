# PayLens environment variables — the source of truth (docs/vault/design/deployment.md).
# Copy to `.env` for local development. `.env` is git-ignored; real secrets live only in
# Vercel's environment settings. Values below are local defaults or placeholders.

# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database ---
# API connection. In production this is Neon's *pooled* string (host contains "-pooler").
DATABASE_URL=postgres://paylens:paylens@localhost:5432/paylens
# Migrations and seed. In production this is Neon's *direct* (non-pooled) string.
DATABASE_URL_DIRECT=postgres://paylens:paylens@localhost:5432/paylens

# --- Sessions (Phase 2) ---
# At least 32 random bytes, e.g. `node -e "console.log(crypto.randomBytes(32).toString('base64url'))"`
SESSION_SECRET=replace-with-32-plus-random-bytes
SESSION_TTL_HOURS=12
SESSION_MAX_DAYS=7
# The web origin: used for the CSRF origin check and cookie settings.
APP_ORIGIN=http://localhost:4200

# --- Google Sign-In (Phase 2) ---
# The OAuth client id is public; the web app reads the VITE_ copy at build time.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Comma-separated. Who may sign in, and who becomes admin on first sign-in.
ALLOWED_EMAIL_DOMAINS=
ADMIN_EMAILS=

# --- Demo mode ---
DEMO_MODE=true
DEMO_RESET_TOKEN=replace-with-a-random-token

# --- "Ask about pay" assistant (Phase 4) ---
AI_ENABLED=false
AI_MODEL=
# Set the key for the provider named in AI_MODEL; leave the others empty.
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
AI_DAILY_CAP=50
AI_DAILY_TOKEN_BUDGET=2000000

# --- Docs and deployment ---
# Serve OpenAPI at /api/docs in production too (always on outside production).
DOCS_PUBLIC=true
# Run `pnpm db:migrate` during the Vercel build of the API (ADR-008).
RUN_MIGRATIONS_ON_BUILD=false
